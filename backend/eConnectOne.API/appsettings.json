{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "PLACEHOLDER_SET_VIA_ENV_VAR"
  },
  "Database": {
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "EnableLogging": false
  },
  "Jwt": {
    "Key": "PLACEHOLDER_SET_VIA_ENV_VAR",
    "Issuer": "eConnectOne",
    "Audience": "eConnectOne.UI",
    "DurationInMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://diweshtanwar.github.io",
      "https://diweshtanwar.github.io/eConnectOneV1"
    ]
  },
  "Session": {
    "IdleTimeoutMinutes": 10
  }
}