# ─────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — Docker Desktop
# ─────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Edit .env with your values (never commit .env to git)
# 3. Dev (backend + Vite hot-reload frontend + postgres):  docker compose up --build
# 4. Prod-like (single combined app container + postgres):  docker compose -f docker-compose.prod.yml up --build
# ─────────────────────────────────────────────────────────

# PostgreSQL (local Docker)
POSTGRES_PASSWORD=postgres@123

# Backend reads this automatically
DATABASE_URL=postgresql://postgres:postgres@123@postgres:5432/eConnectOne

# Frontend API URL (points to local backend) - only used by the docker-compose.yml
# dev frontend service; the combined production container serves the API same-origin.
VITE_API_BASE_URL=http://localhost:10000/api
