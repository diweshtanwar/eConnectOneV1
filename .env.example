# Environment Variables Template
# Copy this file to .env and fill in actual values for local development
# NEVER commit .env to git - it contains secrets!

# Database
POSTGRES_PASSWORD=YourSecurePasswordHere123!
DATABASE_URL=postgresql://postgres:YourSecurePasswordHere123!@postgres:5432/eConnectOne

# Backend
ASPNETCORE_URLS=http://+:10000
DOTNET_ENVIRONMENT=Development

# Frontend
VITE_API_BASE_URL=http://localhost:10000/api

# For production (Azure)
# VITE_API_BASE_URL=https://econnectone-backend.azurewebsites.net/api
