# Frontend Environment Variables

# API Base URL - only needed if you want to override the default relative "/api"
# (used when the frontend is served from the same container/origin as the backend).
# Leave unset for same-origin production deployments (Azure Container App).
VITE_API_BASE_URL=http://localhost:5001/api

# This file is for documentation. Create .env.local for actual local overrides.
# Do NOT commit .env files with real secrets to GitHub.
